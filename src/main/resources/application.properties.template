# ===================================================================
# Spring Boot Application Properties Template
# 請複製此檔案並重新命名為 application.properties，然後填入您的實際設定。
# ===================================================================

# 1. 伺服器埠號設定
server.port=${SERVER_PORT:8080}

# 2. MySQL 連線設定
# 提示：請確保目標 MySQL 伺服器已建立或允許建立此資料庫
spring.datasource.url=jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/${DB_NAME:shop_db}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:YOUR_DATABASE_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 3. JPA 自動建表與日誌
spring.jpa.database-platform=org.hibernate.dialect.MySQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# 4. 安全性設定 (JWT & 管理員)
# 警告：請務必在正式環境修改此金鑰，以確保 Token 安全
jwt.secret=${JWT_SECRET:YOUR_SUPER_SECRET_KEY_MIN_32_CHARS}

# 預設管理員帳號設定
admin.username=${ADMIN_INITIAL_USERNAME:admin}
admin.password=${ADMIN_INITIAL_PASSWORD:YOUR_ADMIN_PASSWORD}

# 5. Redis 設定（未啟動時 ProductCacheService 會自動降級，不影響 API）
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.timeout=2000ms
spring.data.redis.connect-timeout=2000ms

# 6. 檔案上傳設定
# 設定圖片儲存的本地路徑（這裡以專案目錄底下的 uploads 資料夾為例）
file.upload-dir=${UPLOAD_DIR:./uploads}

# 限制單一檔案最大 5MB，總傳輸量最大 10MB
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=10MB